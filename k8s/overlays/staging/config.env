# Configuração NÃO sensível do ambiente staging (versionada).
# Secrets vão em secrets.env.
APP_ENV=staging

FACEIT_API_BASE_URL=https://open.faceit.com/data/v4

MYSQL_HOST=mysql
MYSQL_PORT=3306
STATS_DB_NAME=lobbysheriff_stats
STATS_DB_USER=stats
PLAYERS_DB_NAME=lobbysheriff_players
PLAYERS_DB_USER=players

REDIS_HOST=redis
REDIS_PORT=6379

GO_STATS_API_PORT=8080
PHP_PLAYERS_API_PORT=8081
PHP_PLAYERS_API_URL=http://php-players-api:8081

SYNC_INTERVAL=15m
