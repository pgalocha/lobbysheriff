# Copiar para .env e preencher:  cp .env.example .env
# NUNCA commitar o .env.

# ─── Geral ───────────────────────────────────────────────────────
APP_ENV=local

# ─── FACEIT (apenas backend) ─────────────────────────────────────
FACEIT_API_KEY=
FACEIT_API_BASE_URL=https://open.faceit.com/data/v4

# ─── MySQL ───────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me

# Schema e utilizador do go-stats-api
STATS_DB_NAME=lobbysheriff_stats
STATS_DB_USER=stats
STATS_DB_PASSWORD=change-me

# Schema e utilizador do php-players-api
PLAYERS_DB_NAME=lobbysheriff_players
PLAYERS_DB_USER=players
PLAYERS_DB_PASSWORD=change-me

# ─── Redis ───────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Serviços ────────────────────────────────────────────────────
GO_STATS_API_PORT=8080
PHP_PLAYERS_API_PORT=8081
PHP_PLAYERS_API_URL=http://php-players-api:8081
# Origens que podem chamar a API a partir do browser (CORS), separadas por vírgulas.
# Localmente: o Swagger UI. Em staging/produção fica vazio (tudo passa pelo gateway).
CORS_ALLOWED_ORIGINS=http://localhost:8090
# Token partilhado para os endpoints internos PHP ↔ Go
INTERNAL_API_TOKEN=change-me

# Intervalo de sincronização com a FACEIT
SYNC_INTERVAL=15m

# ─── Observabilidade ─────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=change-me
